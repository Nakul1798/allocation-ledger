# Copy this file to .env for local development (python-dotenv loads it automatically
# if you run `flask run`; wsgi.py itself does not auto-load .env, so export these
# into your shell -- or use `flask run` with FLASK_APP=wsgi.py -- for local testing).

FLASK_APP=wsgi.py
FLASK_ENV=development

# Long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Leave unset locally to fall back to a SQLite file in instance/app.db.
# On Render, this is supplied automatically by the linked Postgres database.
DATABASE_URL=

# Used once by `flask seed-admin` to create the first Program Director account
# non-interactively. Safe to remove from the environment after first deploy.
ADMIN_NAME=Program Director
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=change-me-min-10-characters

# --- Local network hosting only (see README "Local network hosting") -------

# Only read by `flask notion-sync` -- the web app itself never touches this,
# so nobody who logs into the dashboard needs (or sees) a Notion token.
# Create one at https://www.notion.so/my-integrations, share the three
# databases with it, then paste the secret here. Never commit this value.
NOTION_TOKEN=

# Set to false only for LAN-only hosting over plain http:// (no TLS). Leave
# as "true" (the default) for anything reachable over the internet.
SESSION_COOKIE_SECURE=true

# --- Optional: AI Assistant page ------------------------------------------

# Leave blank to keep the "AI Assistant" page disabled (it shows a plain
# setup note instead). Get a key at https://console.anthropic.com/settings/keys
# and paste it here to turn it on. Never commit a real key -- this file is
# just an example.
ANTHROPIC_API_KEY=

# Only needed if your account doesn't have access to the default model.
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
