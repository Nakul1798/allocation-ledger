# Copy this file to .env for local development (python-dotenv loads it automatically
# if you run `flask run`; wsgi.py itself does not auto-load .env, so export these
# into your shell — or use `flask run` with FLASK_APP=wsgi.py — for local testing).

FLASK_APP=wsgi.py
FLASK_ENV=development

# Long random string. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Leave unset locally to fall back to a SQLite file in instance/app.db.
# On Render, this is supplied automatically by the linked Postgres database.
DATABASE_URL=

# Used once by `flask seed-admin` to create the first Program Director account
# non-interactively. Safe to remove from the environment after first deploy.
ADMIN_NAME=Program Director
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=change-me-min-10-characters
